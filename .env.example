# Connection string for messageServer's database, which holds the
# authorizedUsers and unauthorizedUsers tables and the userNames and
# chatMembers tables behind usernames and chats. Copy this file to .env
# (.env is gitignored) and point it at your own database.
#
# Postgres:
#   DATABASE_URL=postgres://chat:secret@localhost:5432/messages?sslmode=disable
#
# SQLite, for running the server on a laptop with no database to point at.
DATABASE_URL=sqlite:./authorizedUsers.db

# infra/terraform creates a free-tier AWS database and prints this line:
#
#   cd infra/terraform && terraform output -raw database_url
#
# Create the tables with:
#
#   go run ./migrate
#
# The server also applies pending migrations at startup. Pass -require-schema to
# stop it doing that, for a deployment whose database user has no DDL rights.
